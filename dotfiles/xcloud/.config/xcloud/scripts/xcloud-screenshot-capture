#!/usr/bin/env bash
# Shared plain-grim capture primitive, sourced by both hypr/scripts/screenshot.sh
# and xcloud-screenshot -- kept in one place so the two don't drift out of sync
# with each other (same rationale as xcloud-screenshot-settings, which this
# depends on for $image_format). Only covers the plain-grim paths; hyprshot
# capture (screenshot.sh's rofi-menu "output"/"area" modes) has no equivalent
# in xcloud-screenshot and stays local to screenshot.sh.

# Captures to $2 (a full output path) via grim, using $image_format (must
# already be set by xcloud-screenshot-settings). $1 is an optional grim -g
# geometry string; pass "" to capture the whole desktop.
# shellcheck disable=SC2154 # image_format set by the sourced xcloud-screenshot-settings
xcloud_grim_capture() {
    local geometry="$1" out_path="$2"
    if [[ -n "$geometry" ]]; then
        grim -g "$geometry" -t "$image_format" "$out_path"
    else
        grim -t "$image_format" "$out_path"
    fi
}
